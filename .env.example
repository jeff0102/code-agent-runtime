# ==============================================================================
# LLM PROVIDERS CONFIGURATION
# ==============================================================================
# Primary LLM: Google AI Studio Key (Gemini 2.5 Flash Free / Pay-as-you-go)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq Cloud API Key (Free tier - Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# WORKSPACE TARGET DIRECTORY
# ==============================================================================
# Absolute path to the external repository where the agent should write code.
# Linux/macOS: /home/username/projects/my-target-app
# Windows: C:/Users/username/projects/my-target-app
WORKSPACE_PATH=/absolute/path/to/target/project

# ==============================================================================
# OPTIONAL CLOUD CREDENTIALS (PASSED TO AGENT ENVIRONMENT IF NEEDED)
# ==============================================================================
HEROKU_API_KEY=your_heroku_api_key_here
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require