# ==============================================================================
# LLM PROVIDERS CONFIGURATION
# ==============================================================================
# Primary LLM: Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM: Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# TARGET WORKSPACE
# ==============================================================================
# Absolute path to the external repository where the Executor works.
# Linux/macOS: /home/username/projects/my-target-app
# Windows: C:/Users/username/projects/my-target-app
WORKSPACE_PATH=/absolute/path/to/target/project

# ==============================================================================
# RUNTIME STATE
# ==============================================================================
# State must live outside the application container and outside the target repo.
STATE_PATH=/absolute/path/to/code-agent-runtime/state

# ==============================================================================
# OPTIONAL CLOUD CREDENTIALS
# ==============================================================================
HEROKU_API_KEY=your_heroku_api_key_here
NEON_DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
