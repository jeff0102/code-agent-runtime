# OpenHands Executor configuration
OPENHANDS_EXECUTOR_MODEL=openai/gemini-primary
OPENHANDS_EXECUTOR_API_KEY=
OPENHANDS_EXECUTOR_BASE_URL=http://localhost:4000/v1

# OpenHands Supervisor configuration
OPENHANDS_SUPERVISOR_MODEL=openai/gemini-primary
OPENHANDS_SUPERVISOR_API_KEY=
OPENHANDS_SUPERVISOR_BASE_URL=http://localhost:4000/v1

