# OpenHands Executor configuration
OPENHANDS_EXECUTOR_MODEL=gemini/gemini-3.8-flash
OPENHANDS_EXECUTOR_API_KEY=
# Leave base URL unset for direct provider access through LiteLLM.
# OPENHANDS_EXECUTOR_BASE_URL=

# OpenHands Supervisor configuration
OPENHANDS_SUPERVISOR_MODEL=gemini/gemini-3.8-flash
OPENHANDS_SUPERVISOR_API_KEY=
# OPENHANDS_SUPERVISOR_BASE_URL=

# Optional numbered fallbacks. The runtime supports any number of fallback slots.
# Fallbacks are tried in order only after transient failures of the primary model.
#
# Example 1: xAI / Grok
# OPENHANDS_EXECUTOR_FALLBACK_1_MODEL=xai/grok-4.7
# OPENHANDS_EXECUTOR_FALLBACK_1_API_KEY=
# OPENHANDS_EXECUTOR_FALLBACK_1_BASE_URL=https://api.x.ai/v1
#
# Example 2: a second Gemini model on the same Google API
# OPENHANDS_EXECUTOR_FALLBACK_2_MODEL=gemini/gemini-3.7-flash
# OPENHANDS_EXECUTOR_FALLBACK_2_API_KEY=
# OPENHANDS_EXECUTOR_FALLBACK_2_BASE_URL=
#
# Configure Supervisor fallbacks independently with the same numbering pattern:
# OPENHANDS_SUPERVISOR_FALLBACK_1_MODEL=...
# OPENHANDS_SUPERVISOR_FALLBACK_1_API_KEY=...
# OPENHANDS_SUPERVISOR_FALLBACK_1_BASE_URL=...
# OPENHANDS_SUPERVISOR_FALLBACK_2_MODEL=...
# OPENHANDS_SUPERVISOR_FALLBACK_2_API_KEY=...
# OPENHANDS_SUPERVISOR_FALLBACK_2_BASE_URL=...

# The target repository and runtime state are supplied by the PyCharm Run Configuration:
# --workspace C:/path/to/open-job-radar
# --state-path C:/path/to/code-agent-runtime/state
#
# Optional runtime flags:
# --max-iterations 5
# --max-tasks 100
# --validation tests::python -m pytest
